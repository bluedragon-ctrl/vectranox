{
  "name": "vectranox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "editor": "vite --config editor/vite.config.ts",
    "worker:dev": "npx wrangler@4 dev --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler@4 deploy --config worker/wrangler.toml",
    "worker:schema": "npx wrangler@4 d1 execute vectranox-scores --config worker/wrangler.toml --file worker/schema.sql"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
